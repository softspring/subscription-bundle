{
    "name": "softspring/subscription-bundle",
    "description": "Subscription plans, subscription lifecycle, and admin subscription flows for Symfony applications",
    "license": "AGPL-3.0-or-later",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.4",
        "doctrine/doctrine-bundle": "^2.10 || ^3.0 || ^4.0",
        "doctrine/orm": "^2.10 || ^3.0 || ^4.0",
        "softspring/crudl-controller": "6.1.*@dev",
        "softspring/customer-bundle": "^5.0 || ^6.0@dev",
        "softspring/doctrine-templates": "6.1.*@dev",
        "softspring/events": "6.1.*@dev",
        "softspring/platform-bundle": "^5.0 || ^6.0@dev",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/form": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/translation": "^6.4 || ^7.4 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.4 || ^8.0",
        "twig/twig": "^3.4"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.50",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.6.7",
        "symfony/polyfill-php85": "^1.33",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.0"
    },
    "conflict": {
        "stripe/stripe-php": "<6.40.0"
    },
    "suggest": {
        "softspring/stripe-platform": "Integrate stripe platform"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Softspring\\SubscriptionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\SubscriptionBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-6.0": "6.0.x-dev",
            "dev-6.1": "6.1.x-dev"
        }
    },
    "scripts": {
        "fix": [
            "vendor/bin/rector process src tests",
            "vendor/bin/php-cs-fixer fix --sequential",
            "composer normalize"
        ],
        "run-tests": [
            "composer validate --strict --no-check-lock --ansi",
            "XDEBUG_MODE=coverage vendor/bin/phpunit",
            "vendor/bin/rector process src tests --dry-run",
            "vendor/bin/phpstan analyse src tests --level 5",
            "vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
            "vendor/bin/yaml-lint .github/ -vvv --parse-tags",
            "vendor/bin/yaml-lint config/ -vvv --parse-tags",
            "vendor/bin/yaml-lint translations/ -vvv --parse-tags"
        ],
        "test": [
            "composer update --no-scripts --ansi",
            "@run-tests"
        ],
        "test-bc": [
            "composer update --no-scripts --ansi --prefer-lowest --prefer-stable",
            "@run-tests"
        ]
    }
}
