{
    "name": "softspring/subscription-bundle",
    "description": "This bundle provides subscription features.",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4",
        "softspring/crudl-bundle": "^5.0",
        "softspring/customer-bundle": "^5.0",
        "softspring/doctrine-templates": "^5.0"
    },
    "require-dev": {
        "symfony/http-kernel": "^5.4 || ^6.0",
        "symfony/dependency-injection": "^5.4 || ^6.0",
        "phpunit/phpunit": "^9.1",
        "doctrine/common": "^2.12",
        "softspring/platform-bundle": "^5.0",
        "friendsofphp/php-cs-fixer": "9999999-dev"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\SubscriptionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\SubscriptionBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
    },
    "conflict": {
        "stripe/stripe-php": "<6.40.0"
    },
    "suggest": {
        "softspring/admin-bundle": "Use softspring admin templates",
        "softspring/core-bundle": "Use softspring core bundle",
        "softspring/platform-bundle": "Integrate external platforms",
        "softspring/stripe-platform": "Integrate stripe platform"
    }
}
